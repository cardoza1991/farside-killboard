# Discord channel webhook (Channel settings > Integrations > Webhooks). Keep secret.
DISCORD_WEBHOOK_URL=
# Optional: comma-separated pilot callsigns, corp names or tickers. Empty = post every kill (grey).
FILTER_NAMES=
# Optional: only fetch one corporation's board (corporation UUID from the /kills/corporation/<id> URL)
CORPORATION_ID=
POLL_SECONDS=45
BACKFILL=0
