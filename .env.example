# --- Discord bot (recommended) ---
DISCORD_TOKEN=
KILLFEED_CHANNEL_ID=
GUILD_ID=
# Daily summary time (UTC, HH:MM); empty disables. Optional weekly extra on this weekday (mon..sun).
SUMMARY_TIME_UTC=18:00
WEEKLY_SUMMARY_DAY=
# --- Feed ---
FILTER_NAMES=DXD
# Corp used by /dxd and summaries (defaults to first FILTER_NAMES entry)
HOME_CORP=DXD
POLL_SECONDS=45
# --- Optional fallback: webhook (used if the channel can't be reached, or by `killboard.py webhook`) ---
DISCORD_WEBHOOK_URL=
